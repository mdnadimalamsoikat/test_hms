# EKBAR chalan:  rman target / @rman_config.rcv
CONFIGURE RETENTION POLICY TO RECOVERY WINDOW OF 7 DAYS;
CONFIGURE CONTROLFILE AUTOBACKUP ON;
CONFIGURE CONTROLFILE AUTOBACKUP FORMAT FOR DEVICE TYPE DISK TO 'D:\HMS_BACKUP\rman\cf_%F';
CONFIGURE CHANNEL DEVICE TYPE DISK FORMAT 'D:\HMS_BACKUP\rman\%d_%T_%U.bkp';
CONFIGURE BACKUP OPTIMIZATION ON;
CONFIGURE DEVICE TYPE DISK BACKUP TYPE TO COMPRESSED BACKUPSET;
SHOW ALL;
